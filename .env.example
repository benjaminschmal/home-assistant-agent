# AI Agent - OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_SECONDS=60

# AI Agent - Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_TIMEOUT_SECONDS=60

# AI Agent - Ollama / local (optional)
OLLAMA_URL=http://192.168.1.23:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# AI Agent - common
MCP_URL=http://<MCP_HOST>:8000/mcp
MCP_TIMEOUT_SECONDS=15
MAX_TOOL_ROUNDS=8
MAX_HISTORY_MESSAGES=12
RELEASE_CHECK_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# MCP Server
HA_URL=http://<HOME_ASSISTANT_HOST>:8123
HA_TOKEN=
HA_TIMEOUT_SECONDS=15
MAX_SEARCH_RESULTS=50
